# Native Windows production values. Copy to ignored .env.production and replace every placeholder.
APP_ENV=production
HOSTNAME=127.0.0.1
PORT=3100
DATABASE_URL=postgresql://hamd_erp:CHANGE_ME@127.0.0.1:5432/hamd_foods_erp
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3100

# Phase 31 remote access: keep BETTER_AUTH_URL on loopback and, after Tailscale
# is connected, trust only the exact HTTPS Serve origin. Never use wildcards.
# BETTER_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_DEVICE.REPLACE_WITH_TAILNET.ts.net

# Native backup storage. Do not use the application runtime directory.
BACKUP_DIRECTORY=C:\ProgramData\HamdFoodsERP\backups
BACKUP_KEEP_LAST=14
BACKUP_KEEP_DAYS=30

# Optional when PostgreSQL client tools are not on PATH.
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin

# Add these temporary values only for the one-off `pnpm production:bootstrap` command, then remove them.
# BOOTSTRAP_ADMIN_NAME=Factory Owner
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_one_off_strong_password
