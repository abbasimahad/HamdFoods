{
  "name": "factory-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented foundation for a food manufacturing ERP.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-database.ts integration",
    "test:e2e": "tsx scripts/test-database.ts e2e",
    "test:e2e:server": "tsx scripts/test-database.ts serve",
    "test:watch": "vitest",
    "test:db:start": "tsx scripts/test-database.ts start",
    "test:db:stop": "tsx scripts/test-database.ts stop",
    "test:db:migrate": "tsx scripts/test-database.ts migrate",
    "test:db:reset": "tsx scripts/test-database.ts reset",
    "test:db:seed": "tsx scripts/test-database.ts seed",
    "db:start": "docker compose up -d database",
    "db:stop": "docker compose stop database",
    "db:status": "docker compose ps database",
    "db:logs": "docker compose logs -f database",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx --env-file=.env scripts/check-database.ts",
    "db:reset": "prisma migrate reset",
    "auth:seed": "tsx --conditions=react-server --env-file=.env scripts/seed-access-control.ts",
    "auth:bootstrap": "tsx --conditions=react-server --env-file=.env scripts/bootstrap-super-admin.ts",
    "master-data:seed": "tsx --conditions=react-server --env-file=.env scripts/seed-master-data.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env scripts/seed-all.ts",
    "verify": "prettier --check . && eslint . && vitest run && prisma validate && prisma generate && tsc --noEmit && next build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.1",
    "decimal.js": "10.6.0",
    "next": "16.3.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
