generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  FINISHED_GOOD
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum PackagingKind {
  BOTTLE
  JAR
  CAP
  LID
  LABEL
  CARTON
  SHRINK_WRAP
  SEAL
  DIVIDER
  BUCKET
  OTHER
}

enum InventoryStatus {
  AVAILABLE
  IN_PRODUCTION
  RESERVED
  QUALITY_HOLD
  QUARANTINE
  REPROCESS
  DAMAGED
  EXPIRED
  SCRAP
  IN_TRANSIT
}

enum InventoryMovementType {
  OPENING_BALANCE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  STATUS_OUT
  STATUS_IN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_REPROCESS_OUTPUT
  PRODUCTION_REJECTED_OUTPUT
  PACKAGING_ISSUE
  PACKAGING_RETURN
  PACKAGING_DAMAGE
  PRODUCTION_OUTPUT
  PACKAGING_CONSUMPTION
  SALES_DISPATCH
  SALES_RETURN
  DAMAGE
  REPROCESS
  SCRAP
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  QC_COMPLETED
  CANCELLED
}

enum GoodsReceiptPurpose {
  PURCHASE
  SUPPLIER_REPLACEMENT
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  AWAITING_REPLACEMENT
  COMPLETED
  CANCELLED
}

enum PurchaseReturnSource {
  QC_REJECTED
  POST_ACCEPTANCE_DEFECT
}

enum PurchaseReturnReason {
  QC_REJECTED
  DAMAGED
  PACKAGING_DEFECT
  WRONG_SPECIFICATION
  WRONG_ITEM
  CONTAMINATION
  EXPIRED
  SHORT_EXPIRY
  LATENT_DEFECT
  SUPPLIER_RECALL
  OTHER
}

enum RecipeStatus {
  DRAFT
  APPROVED
  INACTIVE
}

enum PackagingUsageBasis {
  PER_PIECE
  PER_CARTON
}

enum ProductionBatchStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionMaterialTransactionType {
  ISSUE
  RETURN
  CONSUMPTION
  DAMAGE
}

enum PackagingDamageReason {
  BROKEN
  CRUSHED
  TORN
  MACHINE_SETUP
  PRINT_DEFECT
  FILLING_DAMAGE
  HANDLING_DAMAGE
  OTHER
}

enum ProductionMaterialTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ProductionOutputType {
  GOOD
  REPROCESS
  REJECTED
  PROCESS_LOSS
}

enum ProductionOutputStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ProductionLossReason {
  NORMAL_PROCESS_LOSS
  EVAPORATION
  SPILLAGE
  SAMPLING
  EQUIPMENT_RETAINED
  ABNORMAL_LOSS
  OTHER
}

enum ProductionLossNature {
  NORMAL
  ABNORMAL
}

enum QcRejectionReason {
  DAMAGED
  WRONG_ITEM
  WRONG_SPECIFICATION
  QUALITY_FAILURE
  EXPIRED
  SHORT_EXPIRY
  CONTAMINATION
  PACKAGING_DEFECT
  OTHER
}

model User {
  id                           String                          @id
  name                         String
  email                        String                          @unique
  emailVerified                Boolean                         @default(false)
  image                        String?
  active                       Boolean                         @default(true)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  sessions                     Session[]
  accounts                     Account[]
  roles                        UserRole[]
  inventoryMovements           InventoryMovement[]
  purchaseOrdersCreated        PurchaseOrder[]                 @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved       PurchaseOrder[]                 @relation("PurchaseOrderApprovedBy")
  purchaseOrdersCancelled      PurchaseOrder[]                 @relation("PurchaseOrderCancelledBy")
  goodsReceiptsReceived        GoodsReceipt[]                  @relation("GoodsReceiptReceivedBy")
  goodsReceiptsPosted          GoodsReceipt[]                  @relation("GoodsReceiptPostedBy")
  goodsReceiptsQc              GoodsReceipt[]                  @relation("GoodsReceiptQcBy")
  goodsReceiptsCancelled       GoodsReceipt[]                  @relation("GoodsReceiptCancelledBy")
  purchaseReturnsCreated       PurchaseReturn[]                @relation("PurchaseReturnCreatedBy")
  purchaseReturnsPosted        PurchaseReturn[]                @relation("PurchaseReturnPostedBy")
  purchaseReturnsCancelled     PurchaseReturn[]                @relation("PurchaseReturnCancelledBy")
  purchasedMaterialQuarantines PurchasedMaterialQuarantine[]
  recipesCreated               Recipe[]                        @relation("RecipeCreatedBy")
  recipesApproved              Recipe[]                        @relation("RecipeApprovedBy")
  productionBatchesCreated     ProductionBatch[]               @relation("ProductionBatchCreatedBy")
  productionBatchesReleased    ProductionBatch[]               @relation("ProductionBatchReleasedBy")
  productionBatchesCancelled   ProductionBatch[]               @relation("ProductionBatchCancelledBy")
  productionMaterialCreated    ProductionMaterialTransaction[] @relation("ProductionMaterialCreatedBy")
  productionMaterialPosted     ProductionMaterialTransaction[] @relation("ProductionMaterialPostedBy")
  productionMaterialCancelled  ProductionMaterialTransaction[] @relation("ProductionMaterialCancelledBy")
  productionOutputCreated      ProductionOutputTransaction[]   @relation("ProductionOutputCreatedBy")
  productionOutputPosted       ProductionOutputTransaction[]   @relation("ProductionOutputPostedBy")
  productionOutputCancelled    ProductionOutputTransaction[]   @relation("ProductionOutputCancelledBy")
  productionBatchesCompleted   ProductionBatch[]               @relation("ProductionBatchCompletedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  isSystem    Boolean          @default(true)
  isProtected Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permission")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Unit {
  id                               String                              @id @default(uuid())
  code                             String                              @unique
  name                             String
  symbol                           String
  dimension                        UnitDimension
  active                           Boolean                             @default(true)
  createdAt                        DateTime                            @default(now())
  updatedAt                        DateTime                            @updatedAt
  stockItems                       Item[]                              @relation("StockUnit")
  finishedGoodProfiles             FinishedGoodProfile[]               @relation("NetContentUnit")
  inventoryMovements               InventoryMovement[]                 @relation("InventoryCanonicalUnit")
  purchaseOrderLines               PurchaseOrderLine[]                 @relation("PurchaseOrderUnit")
  canonicalOrderLines              PurchaseOrderLine[]                 @relation("PurchaseOrderCanonicalUnit")
  goodsReceiptLines                GoodsReceiptLine[]                  @relation("GoodsReceiptEnteredUnit")
  purchaseReturnLines              PurchaseReturnLine[]                @relation("PurchaseReturnEnteredUnit")
  canonicalPurchaseReturnLines     PurchaseReturnLine[]                @relation("PurchaseReturnCanonicalUnit")
  purchasedMaterialQuarantines     PurchasedMaterialQuarantine[]       @relation("PurchasedMaterialQuarantineUnit")
  recipeStandardBatchUnits         Recipe[]                            @relation("RecipeStandardBatchUnit")
  recipeStandardCanonicalUnits     Recipe[]                            @relation("RecipeStandardCanonicalUnit")
  recipeExpectedOutputUnits        Recipe[]                            @relation("RecipeExpectedOutputUnit")
  recipeExpectedCanonicalUnits     Recipe[]                            @relation("RecipeExpectedCanonicalUnit")
  recipeIngredientUnits            RecipeIngredient[]                  @relation("RecipeIngredientUnit")
  recipeIngredientCanonicalUnits   RecipeIngredient[]                  @relation("RecipeIngredientCanonicalUnit")
  packagingBomLineUnits            PackagingBomLine[]                  @relation("PackagingBomLineUnit")
  packagingBomLineCanonicalUnits   PackagingBomLine[]                  @relation("PackagingBomLineCanonicalUnit")
  productionBatchEnteredUnits      ProductionBatch[]                   @relation("ProductionBatchEnteredUnit")
  productionBatchCanonicalUnits    ProductionBatch[]                   @relation("ProductionBatchCanonicalUnit")
  productionExpectedOutputUnits    ProductionBatch[]                   @relation("ProductionExpectedOutputUnit")
  productionContentUnits           ProductionBatch[]                   @relation("ProductionContentUnit")
  productionMaterialUnits          ProductionMaterialRequirement[]     @relation("ProductionMaterialUnit")
  productionPackagingUnits         ProductionPackagingRequirement[]    @relation("ProductionPackagingUnit")
  productionMaterialEnteredUnits   ProductionMaterialTransactionLine[] @relation("ProductionMaterialEnteredUnit")
  productionMaterialCanonicalUnits ProductionMaterialTransactionLine[] @relation("ProductionMaterialCanonicalUnit")
  productionOutputEnteredUnits     ProductionOutputTransaction[]       @relation("ProductionOutputEnteredUnit")
  productionOutputCanonicalUnits   ProductionOutputTransaction[]       @relation("ProductionOutputCanonicalUnit")

  @@unique([id, dimension], map: "unit_id_dimension_uidx")
  @@index([active, name])
  @@map("unit")
}

model ItemCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  itemType    ItemType
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@unique([id, itemType], map: "item_category_id_type_uidx")
  @@index([itemType, active, name])
  @@map("item_category")
}

model Item {
  id                                 String                              @id @default(uuid())
  code                               String                              @unique
  name                               String
  itemType                           ItemType
  categoryId                         String
  stockUnitId                        String
  packagingKind                      PackagingKind?
  description                        String?
  active                             Boolean                             @default(true)
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  category                           ItemCategory                        @relation(fields: [categoryId, itemType], references: [id, itemType], onDelete: Restrict)
  stockUnit                          Unit                                @relation("StockUnit", fields: [stockUnitId], references: [id], onDelete: Restrict)
  finishedGoodProfile                FinishedGoodProfile?
  inventoryMovements                 InventoryMovement[]
  purchaseOrderLines                 PurchaseOrderLine[]
  inventoryLots                      InventoryLot[]
  purchaseReturnLines                PurchaseReturnLine[]
  purchasedMaterialQuarantines       PurchasedMaterialQuarantine[]
  recipes                            Recipe[]                            @relation("RecipeFinishedGood")
  recipeIngredients                  RecipeIngredient[]
  packagingBomLines                  PackagingBomLine[]
  productionBatches                  ProductionBatch[]                   @relation("ProductionBatchFinishedGood")
  productionMaterialRequirements     ProductionMaterialRequirement[]
  productionPackagingRequirements    ProductionPackagingRequirement[]
  productionMaterialTransactionLines ProductionMaterialTransactionLine[]
  productionLots                     ProductionLot[]

  @@unique([id, itemType], map: "item_id_type_uidx")
  @@index([itemType, active, name])
  @@index([itemType, code])
  @@index([categoryId])
  @@index([stockUnitId])
  @@map("item")
}

model Warehouse {
  id                             String                              @id @default(uuid())
  code                           String                              @unique
  name                           String
  description                    String?
  active                         Boolean                             @default(true)
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  movements                      InventoryMovement[]
  goodsReceipts                  GoodsReceipt[]
  purchaseReturns                PurchaseReturn[]
  purchasedMaterialQuarantines   PurchasedMaterialQuarantine[]
  productionRawMaterialBatches   ProductionBatch[]                   @relation("ProductionRawMaterialWarehouse")
  productionPackagingBatches     ProductionBatch[]                   @relation("ProductionPackagingWarehouse")
  productionDestinationBatches   ProductionBatch[]                   @relation("ProductionDestinationWarehouse")
  productionMaterialSources      ProductionMaterialTransactionLine[] @relation("ProductionMaterialSourceWarehouse")
  productionMaterialDestinations ProductionMaterialTransactionLine[] @relation("ProductionMaterialDestinationWarehouse")
  productionOutputDestinations   ProductionOutputTransaction[]

  @@index([active, name])
  @@map("warehouse")
}

model InventoryMovement {
  id                                  String                             @id @default(uuid())
  itemId                              String
  warehouseId                         String
  status                              InventoryStatus
  quantity                            Decimal                            @db.Decimal(24, 6)
  canonicalUnitId                     String
  movementType                        InventoryMovementType
  referenceType                       String
  referenceId                         String?
  sourceKey                           String?
  groupId                             String?
  reason                              String
  postedAt                            DateTime                           @default(now())
  createdByUserId                     String
  inventoryLotId                      String?
  productionBatchId                   String?
  productionMaterialTransactionLineId String?
  productionOutputTransactionId       String?
  productionLotId                     String?
  item                                Item                               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse                           Warehouse                          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  canonicalUnit                       Unit                               @relation("InventoryCanonicalUnit", fields: [canonicalUnitId], references: [id], onDelete: Restrict)
  createdBy                           User                               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  inventoryLot                        InventoryLot?                      @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  productionBatch                     ProductionBatch?                   @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  productionMaterialTransactionLine   ProductionMaterialTransactionLine? @relation(fields: [productionMaterialTransactionLineId], references: [id], onDelete: Restrict)
  productionOutputTransaction         ProductionOutputTransaction?       @relation(fields: [productionOutputTransactionId], references: [id], onDelete: Restrict)
  productionLot                       ProductionLot?                     @relation(fields: [productionLotId], references: [id], onDelete: Restrict)

  @@unique([sourceKey, movementType], map: "inventory_movement_source_type_uidx")
  @@index([itemId, warehouseId, status, postedAt])
  @@index([warehouseId, postedAt])
  @@index([movementType, postedAt])
  @@index([groupId])
  @@index([createdByUserId])
  @@index([inventoryLotId, postedAt])
  @@index([productionBatchId, status, postedAt])
  @@index([productionMaterialTransactionLineId])
  @@index([productionOutputTransactionId])
  @@index([productionLotId, postedAt])
  @@map("inventory_movement")
}

model FinishedGoodProfile {
  itemId                  String        @id
  itemType                ItemType      @default(FINISHED_GOOD)
  netContentQuantity      Decimal       @db.Decimal(18, 6)
  netContentUnitId        String
  netContentUnitDimension UnitDimension
  piecesPerCarton         Int
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  item                    Item          @relation(fields: [itemId, itemType], references: [id, itemType], onDelete: Restrict)
  netContentUnit          Unit          @relation("NetContentUnit", fields: [netContentUnitId, netContentUnitDimension], references: [id, dimension], onDelete: Restrict)

  @@unique([itemId, itemType], map: "finished_good_profile_item_type_uidx")
  @@index([netContentUnitId])
  @@map("finished_good_profile")
}

model Supplier {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String
  contactPerson     String
  phone             String
  secondaryPhone    String?
  email             String
  address           String
  city              String
  taxRegistrationNo String?
  paymentTermsDays  Int?
  notes             String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  inventoryLots     InventoryLot[]
  purchaseReturns   PurchaseReturn[]

  @@index([active, name])
  @@index([city, active])
  @@map("supplier")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  number               String              @unique
  supplierId           String
  orderDate            DateTime            @db.Date
  expectedDeliveryDate DateTime?           @db.Date
  status               PurchaseOrderStatus @default(DRAFT)
  supplierReference    String?
  notes                String?
  subtotal             Decimal             @db.Decimal(24, 6)
  discountTotal        Decimal             @db.Decimal(24, 6)
  taxTotal             Decimal             @db.Decimal(24, 6)
  grandTotal           Decimal             @db.Decimal(24, 6)
  createdByUserId      String
  approvedByUserId     String?
  approvedAt           DateTime?
  cancelledByUserId    String?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy            User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?               @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  cancelledBy          User?               @relation("PurchaseOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  lines                PurchaseOrderLine[]
  goodsReceipts        GoodsReceipt[]
  purchaseReturns      PurchaseReturn[]

  @@unique([id, supplierId], map: "purchase_order_id_supplier_uidx")
  @@index([status, orderDate])
  @@index([supplierId, orderDate])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([cancelledByUserId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id                  String               @id @default(uuid())
  purchaseOrderId     String
  position            Int
  itemId              String
  itemType            ItemType
  orderedQuantity     Decimal              @db.Decimal(24, 6)
  orderUnitId         String
  normalizedQuantity  Decimal              @db.Decimal(24, 6)
  canonicalUnitId     String
  unitRate            Decimal              @db.Decimal(24, 6)
  discountPercent     Decimal              @db.Decimal(7, 4)
  taxPercent          Decimal              @db.Decimal(7, 4)
  grossAmount         Decimal              @db.Decimal(24, 6)
  discountAmount      Decimal              @db.Decimal(24, 6)
  taxAmount           Decimal              @db.Decimal(24, 6)
  netAmount           Decimal              @db.Decimal(24, 6)
  notes               String?
  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item                Item                 @relation(fields: [itemId, itemType], references: [id, itemType], onDelete: Restrict)
  orderUnit           Unit                 @relation("PurchaseOrderUnit", fields: [orderUnitId], references: [id], onDelete: Restrict)
  canonicalUnit       Unit                 @relation("PurchaseOrderCanonicalUnit", fields: [canonicalUnitId], references: [id], onDelete: Restrict)
  goodsReceiptLines   GoodsReceiptLine[]
  purchaseReturnLines PurchaseReturnLine[]

  @@unique([purchaseOrderId, position])
  @@unique([id, itemId, canonicalUnitId], map: "purchase_order_line_identity_uidx")
  @@index([itemId])
  @@index([orderUnitId])
  @@index([canonicalUnitId])
  @@map("purchase_order_line")
}

model PurchaseOrderSequence {
  year      Int @id
  nextValue Int

  @@map("purchase_order_sequence")
}

model GoodsReceipt {
  id                         String              @id @default(uuid())
  number                     String              @unique
  purchaseOrderId            String
  supplierId                 String
  receiptDate                DateTime
  warehouseId                String
  supplierDeliveryNumber     String?
  vehicleReference           String?
  notes                      String?
  status                     GoodsReceiptStatus  @default(DRAFT)
  purpose                    GoodsReceiptPurpose @default(PURCHASE)
  purchaseReturnId           String?
  receivedByUserId           String
  postedByUserId             String?
  postedAt                   DateTime?
  qcByUserId                 String?
  qcCompletedAt              DateTime?
  cancelledByUserId          String?
  cancelledAt                DateTime?
  cancellationReason         String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  purchaseOrder              PurchaseOrder       @relation(fields: [purchaseOrderId, supplierId], references: [id, supplierId], onDelete: Restrict)
  supplier                   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse                  Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy                 User                @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  postedBy                   User?               @relation("GoodsReceiptPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  qcBy                       User?               @relation("GoodsReceiptQcBy", fields: [qcByUserId], references: [id], onDelete: Restrict)
  cancelledBy                User?               @relation("GoodsReceiptCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  lines                      GoodsReceiptLine[]
  inventoryLots              InventoryLot[]
  purchaseReturn             PurchaseReturn?     @relation("ReplacementGoodsReceipts", fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  originatingPurchaseReturns PurchaseReturn[]    @relation("OriginalGoodsReceipt")

  @@index([status, receiptDate])
  @@index([purchaseOrderId, receiptDate])
  @@index([supplierId, receiptDate])
  @@index([warehouseId, receiptDate])
  @@index([purchaseReturnId, receiptDate])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                          String                  @id @default(uuid())
  goodsReceiptId              String
  position                    Int
  purchaseOrderLineId         String
  itemId                      String
  enteredQuantity             Decimal                 @db.Decimal(24, 6)
  enteredUnitId               String
  normalizedQuantity          Decimal                 @db.Decimal(24, 6)
  canonicalUnitId             String
  supplierLotNumber           String?
  manufacturingDate           DateTime?               @db.Date
  expiryDate                  DateTime?               @db.Date
  notes                       String?
  purchaseReturnLineId        String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  goodsReceipt                GoodsReceipt            @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine           PurchaseOrderLine       @relation(fields: [purchaseOrderLineId, itemId, canonicalUnitId], references: [id, itemId, canonicalUnitId], onDelete: Restrict)
  enteredUnit                 Unit                    @relation("GoodsReceiptEnteredUnit", fields: [enteredUnitId], references: [id], onDelete: Restrict)
  inventoryLot                InventoryLot?
  qcDecision                  GoodsReceiptQcDecision?
  purchaseReturnLine          PurchaseReturnLine?     @relation(fields: [purchaseReturnLineId], references: [id], onDelete: Restrict)
  originalPurchaseReturnLines PurchaseReturnLine[]    @relation("OriginalPurchaseReturnLine")

  @@unique([goodsReceiptId, position])
  @@unique([goodsReceiptId, purchaseOrderLineId], map: "goods_receipt_line_po_line_uidx")
  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@index([enteredUnitId])
  @@index([purchaseReturnLineId])
  @@map("goods_receipt_line")
}

model InventoryLot {
  id                                 String                              @id @default(uuid())
  itemId                             String
  supplierId                         String
  sourceGoodsReceiptId               String
  sourceReceiptLineId                String                              @unique
  supplierLotNumber                  String?
  manufacturingDate                  DateTime?                           @db.Date
  expiryDate                         DateTime?                           @db.Date
  createdAt                          DateTime                            @default(now())
  item                               Item                                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier                           Supplier                            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceGoodsReceipt                 GoodsReceipt                        @relation(fields: [sourceGoodsReceiptId], references: [id], onDelete: Restrict)
  sourceReceiptLine                  GoodsReceiptLine                    @relation(fields: [sourceReceiptLineId], references: [id], onDelete: Restrict)
  inventoryMovements                 InventoryMovement[]
  purchaseReturnLines                PurchaseReturnLine[]
  purchasedMaterialQuarantines       PurchasedMaterialQuarantine[]
  productionMaterialTransactionLines ProductionMaterialTransactionLine[]

  @@index([itemId, supplierLotNumber])
  @@index([supplierId, createdAt])
  @@index([sourceGoodsReceiptId])
  @@map("inventory_lot")
}

model GoodsReceiptQcDecision {
  id                 String             @id @default(uuid())
  goodsReceiptLineId String             @unique
  acceptedQuantity   Decimal            @db.Decimal(24, 6)
