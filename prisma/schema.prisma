generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  FINISHED_GOOD
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum PackagingKind {
  BOTTLE
  JAR
  CAP
  LID
  LABEL
  CARTON
  SHRINK_WRAP
  SEAL
  DIVIDER
  BUCKET
  OTHER
}

enum InventoryStatus {
  AVAILABLE
  IN_PRODUCTION
  RESERVED
  QUALITY_HOLD
  QUARANTINE
  REPROCESS
  DAMAGED
  EXPIRED
  SCRAP
  IN_TRANSIT
  RETURN_INSPECTION
}

enum InventoryMovementType {
  OPENING_BALANCE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  STATUS_OUT
  STATUS_IN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_REPROCESS_OUTPUT
  PRODUCTION_REJECTED_OUTPUT
  PACKAGING_ISSUE
  PACKAGING_RETURN
  PACKAGING_DAMAGE
  PRODUCTION_OUTPUT
  PACKAGING_CONSUMPTION
  SALES_RESERVATION
  SALES_RESERVATION_RELEASE
  SALES_DISPATCH
  SALES_INVOICE_OUT
  SALES_RETURN
  SALES_RETURN_RECEIPT
  RETURN_TO_AVAILABLE
  RETURN_TO_QUARANTINE
  RETURN_TO_REPROCESS
  RETURN_TO_DAMAGED
  RETURN_TO_EXPIRED
  DISPATCH_REFUSAL_RETURN
  DAMAGE
  REPROCESS
  SCRAP
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_DISPATCHED
  DISPATCHED
  CLOSED
  CANCELLED
}

enum SalesDispatchStatus {
  DRAFT
  POSTED
  DELIVERED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CustomerLedgerEntryType {
  SALES_INVOICE
  CUSTOMER_PAYMENT
  SALES_RETURN_CREDIT
  CREDIT_NOTE
  DEBIT_NOTE
  OPENING_BALANCE
  ADJUSTMENT
}

enum CustomerPaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CustomerPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum SalesReturnStatus {
  DRAFT
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum SalesReturnType {
  INVOICED_RETURN
  DISPATCH_REFUSAL
}

enum SalesReturnReason {
  CUSTOMER_REJECTION
  WRONG_PRODUCT
  WRONG_QUANTITY
  DAMAGED_IN_TRANSIT
  PRODUCT_DEFECT
  PACKAGING_DEFECT
  EXPIRED
  SHORT_EXPIRY
  QUALITY_COMPLAINT
  ORDER_CANCELLED
  OTHER
}

enum SalesReturnInspectionClassification {
  GOOD_RESALE
  QUARANTINE
  REPROCESS
  DAMAGED
  EXPIRED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  QC_COMPLETED
  CANCELLED
}

enum GoodsReceiptPurpose {
  PURCHASE
  SUPPLIER_REPLACEMENT
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  AWAITING_REPLACEMENT
  COMPLETED
  CANCELLED
}

enum PurchaseReturnSource {
  QC_REJECTED
  POST_ACCEPTANCE_DEFECT
}

enum PurchaseReturnReason {
  QC_REJECTED
  DAMAGED
  PACKAGING_DEFECT
  WRONG_SPECIFICATION
  WRONG_ITEM
  CONTAMINATION
  EXPIRED
  SHORT_EXPIRY
  LATENT_DEFECT
  SUPPLIER_RECALL
  OTHER
}

enum RecipeStatus {
  DRAFT
  APPROVED
  INACTIVE
}

enum PackagingUsageBasis {
  PER_PIECE
  PER_CARTON
}

enum ProductionBatchStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionMaterialTransactionType {
  ISSUE
  RETURN
  CONSUMPTION
  DAMAGE
}

enum PackagingDamageReason {
  BROKEN
  CRUSHED
  TORN
  MACHINE_SETUP
  PRINT_DEFECT
  FILLING_DAMAGE
  HANDLING_DAMAGE
  OTHER
}

enum ProductionMaterialTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ProductionOutputType {
  GOOD
  REPROCESS
  REJECTED
  PROCESS_LOSS
}

enum ProductionOutputStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ProductionLossReason {
  NORMAL_PROCESS_LOSS
  EVAPORATION
  SPILLAGE
  SAMPLING
  EQUIPMENT_RETAINED
  ABNORMAL_LOSS
  OTHER
}

enum ProductionLossNature {
  NORMAL
  ABNORMAL
}

enum InventoryValuationMethod {
  MOVING_WEIGHTED_AVERAGE
}

enum InventoryValuationEntryType {
  OPENING_BALANCE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PURCHASE_RECEIPT
  SUPPLIER_REPLACEMENT
  PURCHASE_RETURN
  LANDED_COST
  PRODUCTION_CONSUMPTION
  PACKAGING_CONSUMPTION
  PRODUCTION_OUTPUT
  SALES_OUT
  SALES_RETURN
  VALUATION_INITIALIZATION
  COST_ADJUSTMENT
}

enum InventoryValuationState {
  FINAL
  PROVISIONAL
  MISSING_VALUATION_BASIS
}

enum LandedCostStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum LandedCostAllocationMethod {
  BY_LINE_VALUE
  BY_QUANTITY
  MANUAL
}

enum ProductionCostCategory {
  DIRECT_LABOR
  MACHINE
  UTILITIES
  FACTORY_OVERHEAD
  OTHER_DIRECT
  COST_CREDIT
}

enum BatchCostingStatus {
  UNCOSTED
  PROVISIONAL
  FINALIZED
}

enum QcRejectionReason {
  DAMAGED
  WRONG_ITEM
  WRONG_SPECIFICATION
  QUALITY_FAILURE
  EXPIRED
  SHORT_EXPIRY
  CONTAMINATION
  PACKAGING_DEFECT
  OTHER
}

model User {
  id                           String                          @id
  name                         String
  email                        String                          @unique
  emailVerified                Boolean                         @default(false)
  image                        String?
  active                       Boolean                         @default(true)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  sessions                     Session[]
  accounts                     Account[]
  roles                        UserRole[]
  inventoryMovements           InventoryMovement[]
  purchaseOrdersCreated        PurchaseOrder[]                 @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved       PurchaseOrder[]                 @relation("PurchaseOrderApprovedBy")
  purchaseOrdersCancelled      PurchaseOrder[]                 @relation("PurchaseOrderCancelledBy")
  goodsReceiptsReceived        GoodsReceipt[]                  @relation("GoodsReceiptReceivedBy")
  goodsReceiptsPosted          GoodsReceipt[]                  @relation("GoodsReceiptPostedBy")
  goodsReceiptsQc              GoodsReceipt[]                  @relation("GoodsReceiptQcBy")
  goodsReceiptsCancelled       GoodsReceipt[]                  @relation("GoodsReceiptCancelledBy")
  purchaseReturnsCreated       PurchaseReturn[]                @relation("PurchaseReturnCreatedBy")
  purchaseReturnsPosted        PurchaseReturn[]                @relation("PurchaseReturnPostedBy")
  purchaseReturnsCancelled     PurchaseReturn[]                @relation("PurchaseReturnCancelledBy")
  purchasedMaterialQuarantines PurchasedMaterialQuarantine[]
  recipesCreated               Recipe[]                        @relation("RecipeCreatedBy")
  recipesApproved              Recipe[]                        @relation("RecipeApprovedBy")
  productionBatchesCreated     ProductionBatch[]               @relation("ProductionBatchCreatedBy")
  productionBatchesReleased    ProductionBatch[]               @relation("ProductionBatchReleasedBy")
  productionBatchesCancelled   ProductionBatch[]               @relation("ProductionBatchCancelledBy")
  productionMaterialCreated    ProductionMaterialTransaction[] @relation("ProductionMaterialCreatedBy")
  productionMaterialPosted     ProductionMaterialTransaction[] @relation("ProductionMaterialPostedBy")
  productionMaterialCancelled  ProductionMaterialTransaction[] @relation("ProductionMaterialCancelledBy")
  productionOutputCreated      ProductionOutputTransaction[]   @relation("ProductionOutputCreatedBy")
  productionOutputPosted       ProductionOutputTransaction[]   @relation("ProductionOutputPostedBy")
  productionOutputCancelled    ProductionOutputTransaction[]   @relation("ProductionOutputCancelledBy")
  productionBatchesCompleted   ProductionBatch[]               @relation("ProductionBatchCompletedBy")
  salespersons                 Salesperson[]                   @relation("SalespersonLinkedUser")
  salesOrdersCreated           SalesOrder[]                    @relation("SalesOrderCreatedBy")
  salesOrdersApproved          SalesOrder[]                    @relation("SalesOrderApprovedBy")
  salesOrdersCancelled         SalesOrder[]                    @relation("SalesOrderCancelledBy")
  salesDispatchesCreated       SalesDispatch[]                 @relation("SalesDispatchCreatedBy")
  salesDispatchesPosted        SalesDispatch[]                 @relation("SalesDispatchPostedBy")
  salesDispatchesDelivered     SalesDispatch[]                 @relation("SalesDispatchDeliveredBy")
  salesDispatchesCancelled     SalesDispatch[]                 @relation("SalesDispatchCancelledBy")
  salesInvoicesCreated         SalesInvoice[]                  @relation("SalesInvoiceCreatedBy")
  salesInvoicesPosted          SalesInvoice[]                  @relation("SalesInvoicePostedBy")
  salesInvoicesCancelled       SalesInvoice[]                  @relation("SalesInvoiceCancelledBy")
  salesReturnsCreated          SalesReturn[]                   @relation("SalesReturnCreatedBy")
  salesReturnsReceived         SalesReturn[]                   @relation("SalesReturnReceivedBy")
  salesReturnsInspected        SalesReturn[]                   @relation("SalesReturnInspectedBy")
  salesReturnsCompleted        SalesReturn[]                   @relation("SalesReturnCompletedBy")
  salesReturnsCancelled        SalesReturn[]                   @relation("SalesReturnCancelledBy")
  salesReturnInspections       SalesReturnInspection[]         @relation("SalesReturnInspectionCreatedBy")
  customerPaymentsCreated      CustomerPayment[]               @relation("CustomerPaymentCreatedBy")
  customerPaymentsPosted       CustomerPayment[]               @relation("CustomerPaymentPostedBy")
  customerPaymentsCancelled    CustomerPayment[]               @relation("CustomerPaymentCancelledBy")
  customerPaymentAllocations   CustomerPaymentAllocation[]     @relation("CustomerPaymentAllocationCreatedBy")
  customerLedgerEntries        CustomerLedgerEntry[]
  inventoryValuationEntries    InventoryValuationEntry[]       @relation("InventoryValuationCreatedBy")
  valuationIssuesResolved      InventoryValuationIssue[]       @relation("InventoryValuationIssueResolvedBy")
  landedCostsCreated           LandedCost[]                    @relation("LandedCostCreatedBy")
  landedCostsPosted            LandedCost[]                    @relation("LandedCostPostedBy")
  valuationAdjustmentsCreated  InventoryValuationAdjustment[]  @relation("InventoryValuationAdjustmentCreatedBy")
  productionCostEntriesCreated ProductionCostEntry[]           @relation("ProductionCostEntryCreatedBy")
  batchCostsFinalized          ProductionBatchCostSnapshot[]   @relation("ProductionBatchCostFinalizedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  isSystem    Boolean          @default(true)
  isProtected Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permission")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Unit {
  id                               String                              @id @default(uuid())
  code                             String                              @unique
  name                             String
  symbol                           String
  dimension                        UnitDimension
  active                           Boolean                             @default(true)
  createdAt                        DateTime                            @default(now())
  updatedAt                        DateTime                            @updatedAt
  stockItems                       Item[]                              @relation("StockUnit")
  finishedGoodProfiles             FinishedGoodProfile[]               @relation("NetContentUnit")
  inventoryMovements               InventoryMovement[]                 @relation("InventoryCanonicalUnit")
  purchaseOrderLines               PurchaseOrderLine[]                 @relation("PurchaseOrderUnit")
  canonicalOrderLines              PurchaseOrderLine[]                 @relation("PurchaseOrderCanonicalUnit")
  goodsReceiptLines                GoodsReceiptLine[]                  @relation("GoodsReceiptEnteredUnit")
  purchaseReturnLines              PurchaseReturnLine[]                @relation("PurchaseReturnEnteredUnit")
  canonicalPurchaseReturnLines     PurchaseReturnLine[]                @relation("PurchaseReturnCanonicalUnit")
  purchasedMaterialQuarantines     PurchasedMaterialQuarantine[]       @relation("PurchasedMaterialQuarantineUnit")
  recipeStandardBatchUnits         Recipe[]                            @relation("RecipeStandardBatchUnit")
  recipeStandardCanonicalUnits     Recipe[]                            @relation("RecipeStandardCanonicalUnit")
  recipeExpectedOutputUnits        Recipe[]                            @relation("RecipeExpectedOutputUnit")
  recipeExpectedCanonicalUnits     Recipe[]                            @relation("RecipeExpectedCanonicalUnit")
  recipeIngredientUnits            RecipeIngredient[]                  @relation("RecipeIngredientUnit")
  recipeIngredientCanonicalUnits   RecipeIngredient[]                  @relation("RecipeIngredientCanonicalUnit")
  packagingBomLineUnits            PackagingBomLine[]                  @relation("PackagingBomLineUnit")
  packagingBomLineCanonicalUnits   PackagingBomLine[]                  @relation("PackagingBomLineCanonicalUnit")
  productionBatchEnteredUnits      ProductionBatch[]                   @relation("ProductionBatchEnteredUnit")
  productionBatchCanonicalUnits    ProductionBatch[]                   @relation("ProductionBatchCanonicalUnit")
  productionExpectedOutputUnits    ProductionBatch[]                   @relation("ProductionExpectedOutputUnit")
  productionContentUnits           ProductionBatch[]                   @relation("ProductionContentUnit")
  productionMaterialUnits          ProductionMaterialRequirement[]     @relation("ProductionMaterialUnit")
  productionPackagingUnits         ProductionPackagingRequirement[]    @relation("ProductionPackagingUnit")
  productionMaterialEnteredUnits   ProductionMaterialTransactionLine[] @relation("ProductionMaterialEnteredUnit")
  productionMaterialCanonicalUnits ProductionMaterialTransactionLine[] @relation("ProductionMaterialCanonicalUnit")
  productionOutputEnteredUnits     ProductionOutputTransaction[]       @relation("ProductionOutputEnteredUnit")
  productionOutputCanonicalUnits   ProductionOutputTransaction[]       @relation("ProductionOutputCanonicalUnit")
  salesOrderCanonicalUnits         SalesOrderLine[]                    @relation("SalesOrderCanonicalUnit")
  salesInvoiceCanonicalUnits       SalesInvoiceLine[]                  @relation("SalesInvoiceCanonicalUnit")
  salesReturnCanonicalUnits        SalesReturnLine[]                   @relation("SalesReturnCanonicalUnit")

  @@unique([id, dimension], map: "unit_id_dimension_uidx")
  @@index([active, name])
  @@map("unit")
}

model ItemCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  itemType    ItemType
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@unique([id, itemType], map: "item_category_id_type_uidx")
  @@index([itemType, active, name])
  @@map("item_category")
}

model Item {
  id                                 String                              @id @default(uuid())
  code                               String                              @unique
  name                               String
  itemType                           ItemType
  categoryId                         String
  stockUnitId                        String
  packagingKind                      PackagingKind?
  description                        String?
  active                             Boolean                             @default(true)
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  category                           ItemCategory                        @relation(fields: [categoryId, itemType], references: [id, itemType], onDelete: Restrict)
  stockUnit                          Unit                                @relation("StockUnit", fields: [stockUnitId], references: [id], onDelete: Restrict)
  finishedGoodProfile                FinishedGoodProfile?
  inventoryMovements                 InventoryMovement[]
  purchaseOrderLines                 PurchaseOrderLine[]
  inventoryLots                      InventoryLot[]
  purchaseReturnLines                PurchaseReturnLine[]
  purchasedMaterialQuarantines       PurchasedMaterialQuarantine[]
  recipes                            Recipe[]                            @relation("RecipeFinishedGood")
  recipeIngredients                  RecipeIngredient[]
  packagingBomLines                  PackagingBomLine[]
  productionBatches                  ProductionBatch[]                   @relation("ProductionBatchFinishedGood")
  productionMaterialRequirements     ProductionMaterialRequirement[]
  productionPackagingRequirements    ProductionPackagingRequirement[]
  productionMaterialTransactionLines ProductionMaterialTransactionLine[]
  productionLots                     ProductionLot[]
  salesOrderLines                    SalesOrderLine[]
  salesDispatchLines                 SalesDispatchLine[]
  salesInvoiceLines                  SalesInvoiceLine[]
  salesReturnLines                   SalesReturnLine[]
  inventoryValuationEntries          InventoryValuationEntry[]
  inventoryValuationBalance          InventoryValuationBalance?
  inventoryValuationIssues           InventoryValuationIssue[]
  inventoryValuationAdjustments      InventoryValuationAdjustment[]

  @@unique([id, itemType], map: "item_id_type_uidx")
  @@index([itemType, active, name])
  @@index([itemType, code])
  @@index([categoryId])
  @@index([stockUnitId])
  @@map("item")
}

model Warehouse {
  id                             String                              @id @default(uuid())
  code                           String                              @unique
  name                           String
  description                    String?
  active                         Boolean                             @default(true)
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  movements                      InventoryMovement[]
  goodsReceipts                  GoodsReceipt[]
  purchaseReturns                PurchaseReturn[]
  purchasedMaterialQuarantines   PurchasedMaterialQuarantine[]
  productionRawMaterialBatches   ProductionBatch[]                   @relation("ProductionRawMaterialWarehouse")
  productionPackagingBatches     ProductionBatch[]                   @relation("ProductionPackagingWarehouse")
  productionDestinationBatches   ProductionBatch[]                   @relation("ProductionDestinationWarehouse")
  productionMaterialSources      ProductionMaterialTransactionLine[] @relation("ProductionMaterialSourceWarehouse")
  productionMaterialDestinations ProductionMaterialTransactionLine[] @relation("ProductionMaterialDestinationWarehouse")
  productionOutputDestinations   ProductionOutputTransaction[]
  salesOrders                    SalesOrder[]
  salesDispatches                SalesDispatch[]
  salesReturns                   SalesReturn[]

  @@index([active, name])
  @@map("warehouse")
}

model InventoryMovement {
  id                                  String                             @id @default(uuid())
  itemId                              String
  warehouseId                         String
  status                              InventoryStatus
  quantity                            Decimal                            @db.Decimal(24, 6)
  canonicalUnitId                     String
  movementType                        InventoryMovementType
  referenceType                       String
  referenceId                         String?
  sourceKey                           String?
  groupId                             String?
  reason                              String
  postedAt                            DateTime                           @default(now())
  createdByUserId                     String
  inventoryLotId                      String?
  productionBatchId                   String?
  productionMaterialTransactionLineId String?
  productionOutputTransactionId       String?
  productionLotId                     String?
  salesOrderId                        String?
  salesOrderLineId                    String?
  salesDispatchId                     String?
  salesDispatchLineId                 String?
  salesDispatchAllocationId           String?
  salesInvoiceId                      String?
  salesInvoiceLineId                  String?
  salesInvoiceAllocationId            String?
  salesReturnId                       String?
  salesReturnLineId                   String?
  salesReturnInspectionId             String?
  item                                Item                               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse                           Warehouse                          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  canonicalUnit                       Unit                               @relation("InventoryCanonicalUnit", fields: [canonicalUnitId], references: [id], onDelete: Restrict)
  createdBy                           User                               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  inventoryLot                        InventoryLot?                      @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  productionBatch                     ProductionBatch?                   @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  productionMaterialTransactionLine   ProductionMaterialTransactionLine? @relation(fields: [productionMaterialTransactionLineId], references: [id], onDelete: Restrict)
  productionOutputTransaction         ProductionOutputTransaction?       @relation(fields: [productionOutputTransactionId], references: [id], onDelete: Restrict)
  productionLot                       ProductionLot?                     @relation(fields: [productionLotId], references: [id], onDelete: Restrict)
  salesOrder                          SalesOrder?                        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  salesOrderLine                      SalesOrderLine?                    @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  salesDispatch                       SalesDispatch?                     @relation(fields: [salesDispatchId], references: [id], onDelete: Restrict)
  salesDispatchLine                   SalesDispatchLine?                 @relation(fields: [salesDispatchLineId], references: [id], onDelete: Restrict)
  salesDispatchAllocation             SalesDispatchLotAllocation?        @relation(fields: [salesDispatchAllocationId], references: [id], onDelete: Restrict)
  salesInvoice                        SalesInvoice?                      @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  salesInvoiceLine                    SalesInvoiceLine?                  @relation(fields: [salesInvoiceLineId], references: [id], onDelete: Restrict)
  salesInvoiceAllocation              SalesInvoiceLotAllocation?         @relation(fields: [salesInvoiceAllocationId], references: [id], onDelete: Restrict)
  salesReturn                         SalesReturn?                       @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  salesReturnLine                     SalesReturnLine?                   @relation(fields: [salesReturnLineId], references: [id], onDelete: Restrict)
  salesReturnInspection               SalesReturnInspection?             @relation(fields: [salesReturnInspectionId], references: [id], onDelete: Restrict)
  valuationEntry                      InventoryValuationEntry?
  valuationIssue                      InventoryValuationIssue?

  @@unique([sourceKey, movementType], map: "inventory_movement_source_type_uidx")
  @@index([itemId, warehouseId, status, postedAt])
  @@index([warehouseId, postedAt])
  @@index([movementType, postedAt])
  @@index([groupId])
  @@index([createdByUserId])
  @@index([inventoryLotId, postedAt])
  @@index([productionBatchId, status, postedAt])
  @@index([productionMaterialTransactionLineId])
  @@index([productionOutputTransactionId])
  @@index([productionLotId, postedAt])
  @@index([salesOrderId, status, postedAt])
  @@index([salesOrderLineId, status, postedAt])
  @@index([salesDispatchId, status, postedAt])
  @@index([salesDispatchLineId])
  @@index([salesDispatchAllocationId])
  @@index([salesInvoiceId, status, postedAt])
  @@index([salesInvoiceLineId])
  @@index([salesInvoiceAllocationId])
  @@index([salesReturnId, status, postedAt])
  @@index([salesReturnLineId])
  @@index([salesReturnInspectionId])
  @@map("inventory_movement")
}

model FinishedGoodProfile {
  itemId                  String        @id
  itemType                ItemType      @default(FINISHED_GOOD)
  netContentQuantity      Decimal       @db.Decimal(18, 6)
  netContentUnitId        String
  netContentUnitDimension UnitDimension
  piecesPerCarton         Int
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  item                    Item          @relation(fields: [itemId, itemType], references: [id, itemType], onDelete: Restrict)
  netContentUnit          Unit          @relation("NetContentUnit", fields: [netContentUnitId, netContentUnitDimension], references: [id, dimension], onDelete: Restrict)

  @@unique([itemId, itemType], map: "finished_good_profile_item_type_uidx")
  @@index([netContentUnitId])
  @@map("finished_good_profile")
}

model Supplier {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String
  contactPerson     String
  phone             String
  secondaryPhone    String?
  email             String
  address           String
  city              String
  taxRegistrationNo String?
  paymentTermsDays  Int?
  notes             String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  inventoryLots     InventoryLot[]
  purchaseReturns   PurchaseReturn[]

  @@index([active, name])
  @@index([city, active])
  @@map("supplier")
}

model CustomerGroup {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@index([active, name])
  @@map("customer_group")
}

model SalesArea {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
