  transaction            ProductionMaterialTransaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  batchRequirement       ProductionMaterialRequirement?  @relation(fields: [batchRequirementId], references: [id], onDelete: Restrict)
  packagingRequirement   ProductionPackagingRequirement? @relation(fields: [packagingRequirementId], references: [id], onDelete: Restrict)
  item                   Item                            @relation(fields: [itemId, itemType], references: [id, itemType], onDelete: Restrict)
  sourceWarehouse        Warehouse                       @relation("ProductionMaterialSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse?                      @relation("ProductionMaterialDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  inventoryLot           InventoryLot                    @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  enteredUnit            Unit                            @relation("ProductionMaterialEnteredUnit", fields: [enteredUnitId, enteredUnitDimension], references: [id, dimension], onDelete: Restrict)
  canonicalUnit          Unit                            @relation("ProductionMaterialCanonicalUnit", fields: [canonicalUnitId, canonicalUnitDimension], references: [id, dimension], onDelete: Restrict)
  inventoryMovements     InventoryMovement[]

  @@unique([transactionId, position])
  @@index([batchRequirementId])
  @@index([packagingRequirementId])
  @@index([itemId, inventoryLotId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("production_material_transaction_line")
}

model ProductionMaterialTransactionSequence {
  materialType    ItemType
  transactionType ProductionMaterialTransactionType
  year            Int
  nextValue       Int

  @@id([materialType, transactionType, year])
  @@map("production_material_transaction_sequence")
}

model ProductionLot {
  id                        String                        @id @default(uuid())
  lotNumber                 String                        @unique
  productionBatchId         String                        @unique
  finishedGoodId            String
  finishedGoodType          ItemType                      @default(FINISHED_GOOD)
  recipeId                  String
  recipeVersion             Int
  productionDate            DateTime                      @db.Date
  expiryDate                DateTime?                     @db.Date
  createdAt                 DateTime                      @default(now())
  productionBatch           ProductionBatch               @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  finishedGood              Item                          @relation(fields: [finishedGoodId, finishedGoodType], references: [id, itemType], onDelete: Restrict)
  recipe                    Recipe                        @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  outputTransactions        ProductionOutputTransaction[]
  inventoryMovements        InventoryMovement[]
  salesDispatchAllocations  SalesDispatchLotAllocation[]
  salesInvoiceAllocations   SalesInvoiceLotAllocation[]
  salesReturnLines          SalesReturnLine[]
  productionCostSnapshot    ProductionBatchCostSnapshot?
  inventoryValuationEntries InventoryValuationEntry[]

  @@index([finishedGoodId, productionDate])
  @@index([recipeId])
  @@map("production_lot")
}

model ProductionOutputTransaction {
  id                     String                 @id @default(uuid())
  outputNumber           String                 @unique
  productionBatchId      String
  outputType             ProductionOutputType
  transactionDate        DateTime               @default(now())
  status                 ProductionOutputStatus @default(DRAFT)
  cartons                Int?
  loosePieces            Int?
  totalPieces            Decimal?               @db.Decimal(24, 6)
  enteredQuantity        Decimal?               @db.Decimal(24, 6)
  enteredUnitId          String?
  enteredUnitDimension   UnitDimension?
  normalizedQuantity     Decimal?               @db.Decimal(24, 6)
  canonicalUnitId        String?
  canonicalUnitDimension UnitDimension?
  productionDate         DateTime               @db.Date
  expiryDate             DateTime?              @db.Date
  destinationWarehouseId String
  productionLotId        String?
  lossReason             ProductionLossReason?
  lossNature             ProductionLossNature?
  notes                  String?
  createdByUserId        String
  postedByUserId         String?
  postedAt               DateTime?
  cancelledByUserId      String?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  productionBatch        ProductionBatch        @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  productionLot          ProductionLot?         @relation(fields: [productionLotId], references: [id], onDelete: Restrict)
  enteredUnit            Unit?                  @relation("ProductionOutputEnteredUnit", fields: [enteredUnitId, enteredUnitDimension], references: [id, dimension], onDelete: Restrict)
  canonicalUnit          Unit?                  @relation("ProductionOutputCanonicalUnit", fields: [canonicalUnitId, canonicalUnitDimension], references: [id, dimension], onDelete: Restrict)
  destinationWarehouse   Warehouse              @relation(fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy              User                   @relation("ProductionOutputCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy               User?                  @relation("ProductionOutputPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                  @relation("ProductionOutputCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  inventoryMovements     InventoryMovement[]

  @@index([productionBatchId, transactionDate])
  @@index([outputType, status, transactionDate])
  @@index([productionLotId])
  @@index([destinationWarehouseId])
  @@map("production_output_transaction")
}

model ProductionOutputSequence {
  year      Int @id
  nextValue Int

  @@map("production_output_sequence")
}

model InventoryValuationBalance {
  itemId            String                   @id
  valuationMethod   InventoryValuationMethod @default(MOVING_WEIGHTED_AVERAGE)
  ownedQuantity     Decimal                  @default(0) @db.Decimal(24, 6)
  inventoryValue    Decimal                  @default(0) @db.Decimal(30, 6)
  averageUnitCost   Decimal?                 @db.Decimal(30, 12)
  missingBasisCount Int                      @default(0)
  lastValuationAt   DateTime?
  updatedAt         DateTime                 @updatedAt
  item              Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([missingBasisCount, lastValuationAt])
  @@map("inventory_valuation_balance")
}

model InventoryValuationEntry {
  id                       String                      @id @default(uuid())
  sourceKey                String                      @unique
  itemId                   String
  inventoryMovementId      String?                     @unique
  entryType                InventoryValuationEntryType
  state                    InventoryValuationState     @default(FINAL)
  valuationMethod          InventoryValuationMethod    @default(MOVING_WEIGHTED_AVERAGE)
  effectiveAt              DateTime
  quantityEffect           Decimal                     @db.Decimal(24, 6)
  unitCost                 Decimal?                    @db.Decimal(30, 12)
  valueDelta               Decimal?                    @db.Decimal(30, 6)
  runningOwnedQuantity     Decimal                     @db.Decimal(24, 6)
  runningInventoryValue    Decimal                     @db.Decimal(30, 6)
  resultingAverageUnitCost Decimal?                    @db.Decimal(30, 12)
  sourceType               String
  sourceId                 String?
  sourceNumber             String?
  productionBatchId        String?
  inventoryLotId           String?
  productionLotId          String?
  notes                    String?
  createdByUserId          String
  createdAt                DateTime                    @default(now())
  item                     Item                        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  inventoryMovement        InventoryMovement?          @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  productionBatch          ProductionBatch?            @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  inventoryLot             InventoryLot?               @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  productionLot            ProductionLot?              @relation(fields: [productionLotId], references: [id], onDelete: Restrict)
  createdBy                User                        @relation("InventoryValuationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([itemId, effectiveAt, id])
  @@index([entryType, effectiveAt])
  @@index([sourceType, sourceId])
  @@index([productionBatchId, effectiveAt])
  @@map("inventory_valuation_entry")
}

model InventoryValuationIssue {
  id                  String                        @id @default(uuid())
  sourceKey           String                        @unique
  itemId              String
  inventoryMovementId String?                       @unique
  quantity            Decimal                       @db.Decimal(24, 6)
  reasonCode          String
  description         String
  detectedAt          DateTime                      @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?
  adjustmentId        String?                       @unique
  item                Item                          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  inventoryMovement   InventoryMovement?            @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  resolvedBy          User?                         @relation("InventoryValuationIssueResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  adjustment          InventoryValuationAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@index([itemId, resolvedAt])
  @@map("inventory_valuation_issue")
}

model InventoryValuationAdjustment {
  id              String                   @id @default(uuid())
  number          String                   @unique
  itemId          String
  valueDelta      Decimal                  @db.Decimal(30, 6)
  reason          String
  reference       String?
  createdByUserId String
  createdAt       DateTime                 @default(now())
  item            Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy       User                     @relation("InventoryValuationAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedIssue   InventoryValuationIssue?

  @@index([itemId, createdAt])
  @@map("inventory_valuation_adjustment")
}

model InventoryValuationAdjustmentSequence {
  year      Int @id
  nextValue Int

  @@map("inventory_valuation_adjustment_sequence")
}

model LandedCost {
  id               String                     @id @default(uuid())
  number           String                     @unique
  goodsReceiptId   String
  allocationMethod LandedCostAllocationMethod
  status           LandedCostStatus           @default(DRAFT)
  category         String
  totalAmount      Decimal                    @db.Decimal(30, 6)
  description      String
  reference        String?
  createdByUserId  String
  postedByUserId   String?
  postedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  goodsReceipt     GoodsReceipt               @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("LandedCostCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy         User?                      @relation("LandedCostPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  allocations      LandedCostAllocation[]

  @@index([goodsReceiptId, status, createdAt])
  @@map("landed_cost")
}

model LandedCostAllocation {
  id                 String           @id @default(uuid())
  landedCostId       String
  goodsReceiptLineId String
  allocatedAmount    Decimal          @db.Decimal(30, 6)
  landedCost         LandedCost       @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  goodsReceiptLine   GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)

  @@unique([landedCostId, goodsReceiptLineId], map: "landed_cost_allocation_unique")
  @@index([goodsReceiptLineId])
  @@map("landed_cost_allocation")
}

model LandedCostSequence {
  year      Int @id
  nextValue Int

  @@map("landed_cost_sequence")
}

model ProductionCostEntry {
  id                String                 @id @default(uuid())
  productionBatchId String
  category          ProductionCostCategory
  amount            Decimal                @db.Decimal(30, 6)
  description       String
  reference         String?
  createdByUserId   String
  createdAt         DateTime               @default(now())
  productionBatch   ProductionBatch        @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  createdBy         User                   @relation("ProductionCostEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([productionBatchId, category, createdAt])
  @@map("production_cost_entry")
}

model ProductionBatchCostSnapshot {
  id                       String             @id @default(uuid())
  productionBatchId        String             @unique
  productionLotId          String             @unique
  status                   BatchCostingStatus @default(FINALIZED)
  rawMaterialCost          Decimal            @db.Decimal(30, 6)
  packagingCost            Decimal            @db.Decimal(30, 6)
  additionalCost           Decimal            @db.Decimal(30, 6)
  costCredits              Decimal            @db.Decimal(30, 6)
  damagedPackagingExposure Decimal            @db.Decimal(30, 6)
  finishedGoodsCostPool    Decimal            @db.Decimal(30, 6)
  actualGoodPieces         Decimal            @db.Decimal(24, 6)
  costPerPiece             Decimal            @db.Decimal(30, 12)
  calculationSnapshot      Json
  finalizedByUserId        String
  finalizedAt              DateTime           @default(now())
  productionBatch          ProductionBatch    @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  productionLot            ProductionLot      @relation(fields: [productionLotId], references: [id], onDelete: Restrict)
  finalizedBy              User               @relation("ProductionBatchCostFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict)

  @@index([status, finalizedAt])
  @@map("production_batch_cost_snapshot")
}
