model Recipe {
  id                               String             @id @default(uuid())
  code                             String
  name                             String
  finishedGoodId                   String
  finishedGoodType                 ItemType           @default(FINISHED_GOOD)
  version                          Int
  standardBatchEnteredQuantity     Decimal            @db.Decimal(24, 6)
  standardBatchUnitId              String
  standardBatchUnitDimension       UnitDimension
  standardBatchNormalizedQuantity  Decimal            @db.Decimal(24, 6)
  standardBatchCanonicalUnitId     String
  standardBatchCanonicalDimension  UnitDimension
  expectedOutputEnteredQuantity    Decimal?           @db.Decimal(24, 6)
  expectedOutputUnitId             String?
  expectedOutputUnitDimension      UnitDimension?
  expectedOutputNormalizedQuantity Decimal?           @db.Decimal(24, 6)
  expectedOutputCanonicalUnitId    String?
  expectedOutputCanonicalDimension UnitDimension?
  status                           RecipeStatus       @default(DRAFT)
  notes                            String?
  effectiveDate                    DateTime?          @db.Date
  createdByUserId                  String
  approvedByUserId                 String?
  approvedAt                       DateTime?
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
  finishedGood                     Item               @relation("RecipeFinishedGood", fields: [finishedGoodId, finishedGoodType], references: [id, itemType], onDelete: Restrict)
  standardBatchUnit                Unit               @relation("RecipeStandardBatchUnit", fields: [standardBatchUnitId, standardBatchUnitDimension], references: [id, dimension], onDelete: Restrict)
  standardBatchCanonicalUnit       Unit               @relation("RecipeStandardCanonicalUnit", fields: [standardBatchCanonicalUnitId, standardBatchCanonicalDimension], references: [id, dimension], onDelete: Restrict)
  expectedOutputUnit               Unit?              @relation("RecipeExpectedOutputUnit", fields: [expectedOutputUnitId, expectedOutputUnitDimension], references: [id, dimension], onDelete: Restrict)
  expectedOutputCanonicalUnit      Unit?              @relation("RecipeExpectedCanonicalUnit", fields: [expectedOutputCanonicalUnitId, expectedOutputCanonicalDimension], references: [id, dimension], onDelete: Restrict)
  createdBy                        User               @relation("RecipeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy                       User?              @relation("RecipeApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  ingredients                      RecipeIngredient[]
  packagingBom                     PackagingBom?
  productionBatches                ProductionBatch[]
  productionLots                   ProductionLot[]

  @@unique([code, version])
  @@index([finishedGoodId, status, version])
  @@index([status, effectiveDate])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@map("recipe")
}

model RecipeIngredient {
