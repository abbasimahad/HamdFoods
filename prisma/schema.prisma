  createdBy                                  User                             @relation("ProductionBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  releasedBy                                 User?                            @relation("ProductionBatchReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)
  cancelledBy                                User?                            @relation("ProductionBatchCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  completedBy                                User?                            @relation("ProductionBatchCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  materialRequirements                       ProductionMaterialRequirement[]
  packagingRequirements                      ProductionPackagingRequirement[]
