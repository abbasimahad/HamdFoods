# Server-only application environment. Do not expose these as NEXT_PUBLIC_* variables.
APP_ENV=development

# Native local PostgreSQL connection. PostgreSQL runs as a normal Windows service on the development PC.
# Replace PASSWORD with the real password created for the dedicated local role.
DATABASE_URL=postgresql://factory_app:PASSWORD@127.0.0.1:5432/factory_erp

# Better Auth server-only configuration. Generate a unique secret for every deployment.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000

# Used only by `pnpm auth:bootstrap`; never use these example credentials in production.
BOOTSTRAP_ADMIN_NAME=Factory Owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_temporary_password
